  "contradiction_update_test": {
    "description": "同一任务先保存旧命令，再保存带有否定/纠正语气的新命令，验证检索时以最新有效记忆为准。",
    "cases": [
      {
        "id": "conflict-cli-001",
        "old_memory": {
          "timestamp": "2026-04-26T10:00:00+08:00",
          "type": "周报发送命令",
          "content": "以后周报发给 A：python scripts/send_weekly.py --to a@example.com"
        },
        "new_memory": {
          "timestamp": "2026-04-27T09:00:00+08:00",
          "type": "周报发送命令",
          "content": "不对，以后周报发给 B：python scripts/send_weekly.py --to b@example.com"
        },
        "query": "发送周报",
        "expected_top1_contains": "--to b@example.com",
        "expected_not_top1_contains": "--to a@example.com"
      },
      {
        "id": "conflict-cli-002",
        "old_memory": {
          "timestamp": "2026-04-26T11:00:00+08:00",
          "type": "部署环境命令",
