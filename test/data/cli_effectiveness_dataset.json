          "type": "部署环境命令",
          "content": "更正，以后部署后台用 prod：kubectl rollout restart deploy/api-server -n prod"
        },
        "query": "部署后台api",
        "expected_top1_contains": "-n prod",
        "expected_not_top1_contains": "-n staging"
      },
      {
        "id": "conflict-cli-003",
        "old_memory": {
          "timestamp": "2026-04-26T12:00:00+08:00",
          "type": "备份保留策略",
          "content": "Redis备份保留3天：python scripts/backup_redis.py --keep-days 3"
        },
        "new_memory": {
          "timestamp": "2026-04-27T09:30:00+08:00",
          "type": "备份保留策略",
          "content": "更新Redis备份策略，保留14天：python scripts/backup_redis.py --keep-days 14"
